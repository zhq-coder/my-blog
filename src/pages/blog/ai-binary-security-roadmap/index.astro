---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
const post = posts.find((item) => item.id === "ai-binary-security-roadmap");

if (!post) {
  throw new Error("Missing blog post: ai-binary-security-roadmap");
}

const { Content } = await render(post);

const date = new Date(post.data.pubDate).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title={`${post.data.title} - Lydia Lab`} description={post.data.description}>
  <article class="article glass-card">
    <div class="post-meta">{date}</div>

    <h1>{post.data.title}</h1>

    <p class="article-lead">
      {post.data.description}
    </p>

    {
      post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )
    }

    <Content />
  </article>
</BaseLayout>
