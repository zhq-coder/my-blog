---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects - Lydia Lab" description="Lydia Lab 的项目列表">
  <section class="page-hero glass-card">
    <p class="section-kicker">Projects</p>
    <h1>项目实验室</h1>
    <p class="page-copy">
      这里整理课程设计、实验系统和个人安全工具的开发进度。
    </p>
  </section>

  <section class="section-block glass-card">
    <div class="grid">
      <article class="card">
        <h3>AI-assisted Binary Analysis System</h3>
        <p>
          面向 ELF / PE 二进制文件的 AI 辅助分析系统，计划支持函数提取、危险 API 识别、调用图分析、LLM 摘要和风险报告。
        </p>
        <div class="tags">
          <span class="tag">IDA</span>
          <span class="tag">Ghidra</span>
          <span class="tag">LLM</span>
        </div>
      </article>

      <article class="card">
        <h3>Security Situation Awareness System</h3>
        <p>
          基于生成式 AI 的内网异常行为阻断与设备态势感知系统，用于异常事件分析、攻击链解释和处置建议生成。
        </p>
        <div class="tags">
          <span class="tag">OpenResty</span>
          <span class="tag">ModSecurity</span>
          <span class="tag">FastAPI</span>
        </div>
      </article>

      <article class="card">
        <h3>Firmware Security Lab</h3>
        <p>
          面向 IoT 固件的安全分析实验，覆盖固件解包、架构识别、Web 服务识别和漏洞函数匹配。
        </p>
        <div class="tags">
          <span class="tag">Firmware</span>
          <span class="tag">IoT</span>
          <span class="tag">Fuzzing</span>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
