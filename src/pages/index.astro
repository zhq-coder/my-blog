---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Lydia Lab"
  description="记录技术、生活、审美与成长的个人空间。"
>
  <section class="hero glass-card">
    <p class="hero-badge">AI Security · Binary Analysis · Web Security</p>

    <h1>Lydia Lab</h1>

    <p class="hero-copy">
      记录技术、生活、审美与成长的个人空间。这里整理网络安全基础、逆向分析、AI 安全系统与日常学习笔记。
    </p>

    <div class="actions">
      <a class="btn primary" href="/blog/">开始阅读</a>
      <a class="btn" href="/message/">留言交流</a>
      <a class="btn" href="/projects/">查看项目</a>
    </div>
  </section>

  <section class="section-block glass-card">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Focus</p>
        <h2 class="section-title">近期关注方向</h2>
      </div>
      <p>把安全基础、工程实践和生成式 AI 串成可以持续迭代的学习路线。</p>
    </div>

    <div class="feature-grid">
      <article class="card">
        <h3>Binary Analysis</h3>
        <p>汇编、C 语言、ELF/PE、IDA/Ghidra 和符号恢复相关实验记录。</p>
      </article>

      <article class="card">
        <h3>AI Security</h3>
        <p>探索 LLM 在漏洞分析、风险解释、告警研判和报告生成中的应用。</p>
      </article>

      <article class="card">
        <h3>Web Defense</h3>
        <p>围绕日志分析、异常行为阻断、内网设备态势感知构建可落地系统。</p>
      </article>
    </div>
  </section>

  <section class="section-block glass-card">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Latest</p>
        <h2 class="section-title">最新文章</h2>
      </div>
      <a class="btn" href="/blog/">全部文章</a>
    </div>

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
